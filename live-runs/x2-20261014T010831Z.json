{"data": [{"attachments": {"media_keys": ["3_2109901933842747393"]}, "author_id": "1341576373672898561", "created_at": "2026-10-13T06:59:58.000Z", "edit_history_tweet_ids": ["2109901943539949865"], "id": "2109901943539949865", "public_metrics": {"bookmark_count": 17, "impression_count": 5270, "like_count": 615, "quote_count": 4, "reply_count": 5, "retweet_count": 51}, "text": "This the Durga that will steal you heart— Ahiritola Sarbojonin. Will be open for Public 15th October (Evening onwards) https://t.co/EYtMJHNMjW", "url": "https://x.com/SudhanidhiB/status/2109901943539949865"}, {"attachments": {"media_keys": ["3_2109717180313124864", "3_2109717180321538048", "3_2109717180317376512", "3_2109717180329893889"]}, "author_id": "1138322180008136704", "created_at": "2026-10-12T18:45:58.000Z", "edit_history_tweet_ids": ["2109717228019171449"], "id": "2109717228019171449", "public_metrics": {"bookmark_count": 2, "impression_count": 1136, "like_count": 33, "quote_count": 0, "reply_count": 0, "retweet_count": 7}, "text": "Glimpses from the auspicious inauguration ceremony of the Durga Puja organised by the Kestopur Prafulla Kanan (Paschim) Adhibasibrinda. https://t.co/u77I5PgcNh", "url": "https://x.com/DrSukantaBJP/status/2109717228019171449"}, {"attachments": {"media_keys": ["3_2109676164633772032", "3_2109676289355640832", "3_2109676519568343040", "3_2109676552518762496"]}, "author_id": "4764615733", "created_at": "2026-10-12T16:04:26.000Z", "edit_history_tweet_ids": ["2109676575524598226"], "id": "2109676575524598226", "public_metrics": {"bookmark_count": 9, "impression_count": 2891, "like_count": 102, "quote_count": 0, "reply_count": 2, "retweet_count": 11}, "text": "📍 New Town Sarbojanin.\n\n🎨 Rintu Das, RSS &amp; BJP.\n\n🌟 The theme celebrates the significance of 'lotus' in Hinduism.\n\n👉 With the regime change, New Town Sarbojanin are doing traditional Durga Puja for the first time. I really loved the pandal, but not the idol.\n\n📌 #DurgaPuja2026 https://t.co/HtC6jOrYAq https://t.co/92sPkGv9CP", "url": "https://x.com/abasu4ever/status/2109676575524598226"}, {"attachments": {"media_keys": ["3_2109578311487954944"]}, "author_id": "1425799761458728962", "created_at": "2026-10-12T11:30:00.000Z", "edit_history_tweet_ids": ["2109607515336184158"], "id": "2109607515336184158", "public_metrics": {"bookmark_count": 1, "impression_count": 197, "like_count": 9, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "text": "Hatibagan Nabinpally presents ‘Hasikhushi Pujo’ as its definitive theme for its 93rd Durga Puja celebration.\n\nRead more: https://t.co/zn7Yj63IvF\n\n#NabinPally #JogendranathSarkar #DurgaPuja #Kolkata #MyKolkata\n\n[Hatibagan Nabin Pally, Jogendranath Sarkar, Children’s Rhyme] https://t.co/haxkFd1g5o", "url": "https://x.com/TT_My_Kolkata/status/2109607515336184158"}, {"attachments": {"media_keys": ["3_2109328149372940288", "3_2109328149389729792", "3_2109328149414817793", "3_2109328149406515200"]}, "author_id": "1138322180008136704", "created_at": "2026-10-11T17:00:19.000Z", "edit_history_tweet_ids": ["2109328252062113979"], "id": "2109328252062113979", "public_metrics": {"bookmark_count": 1, "impression_count": 2472, "like_count": 109, "quote_count": 0, "reply_count": 2, "retweet_count": 11}, "text": "Attended the auspicious inauguration ceremony of the Durga Puja organised by New Town Sarbojanin Durgotsav Samiti.\n\nJai Maa Durga! 🙏 https://t.co/S09cxD6mvf", "url": "https://x.com/DrSukantaBJP/status/2109328252062113979"}], "includes": {"media": [{"height": 2048, "media_key": "3_2109901933842747393", "type": "photo", "url": "https://pbs.twimg.com/media/HUfgoU2bUAE6pJ0.jpg", "width": 1365}, {"height": 1366, "media_key": "3_2109717180313124864", "type": "photo", "url": "https://pbs.twimg.com/media/HUc4mQUaQAAjzGt.jpg", "width": 2048}, {"height": 1366, "media_key": "3_2109717180321538048", "type": "photo", "url": "https://pbs.twimg.com/media/HUc4mQWaoAAOoLC.jpg", "width": 2048}, {"height": 1366, "media_key": "3_21097