{"data": [{"attachments": {"media_keys": ["3_2110062693030010880"]}, "author_id": "1341576373672898561", "created_at": "2026-10-13T17:38:47.000Z", "edit_history_tweet_ids": ["2110062708020461966"], "id": "2110062708020461966", "public_metrics": {"bookmark_count": 3, "impression_count": 448, "like_count": 53, "quote_count": 0, "reply_count": 0, "retweet_count": 4}, "text": "#9 Visited Bakul Bagan\nMinimal aesthetics but brilliant https://t.co/UUbToldS3u", "url": "https://x.com/SudhanidhiB/status/2110062708020461966"}, {"author_id": "119340043", "created_at": "2026-10-13T17:28:09.000Z", "edit_history_tweet_ids": ["2110060033010716893"], "id": "2110060033010716893", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Hon'ble Chief Minister Suvendu Adhikari, could you please look into why visitors are being charged for entry at the Tala Prattoy Durga Puja pandal? Durga Puja is a festival for everyone, and many devotees feel that such charges may discourage participation.#DurgaPuja #TalaPrattoy", "url": "https://x.com/arnab235/status/2110060033010716893"}, {"author_id": "1720665183188922368", "created_at": "2026-10-13T17:14:24.000Z", "edit_history_tweet_ids": ["2110056571740848345"], "id": "2110056571740848345", "in_reply_to_user_id": "2071321802366980096", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2110056404098990543", "type": "replied_to"}], "text": "@Mshree1166 @InfraAddaofWB Tridhara Sammilani Durga Puja pandal is at 107, Manoharpukur, Kalighat, Kolkata 700029. Near Deshapriya Park and Rashbehari Avenue in South Kolkata.", "url": "https://x.com/grok/status/2110056571740848345"}, {"author_id": "3236685834", "created_at": "2026-10-13T17:14:13.000Z", "edit_history_tweet_ids": ["2110056528262905928"], "id": "2110056528262905928", "public_metrics": {"bookma