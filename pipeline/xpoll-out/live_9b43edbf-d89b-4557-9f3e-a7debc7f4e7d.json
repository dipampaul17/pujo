{"data": [{"attachments": {"media_keys": ["3_2112432268010758144", "3_2112432284158849024", "3_2112432299623223296"]}, "author_id": "1023150691030728704", "created_at": "2026-10-20T06:34:47.000Z", "edit_history_tweet_ids": ["2112432323543339227"], "id": "2112432323543339227", "public_metrics": {"bookmark_count": 0, "impression_count": 65, "like_count": 3, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "#139 Visited Chaltabagan Lohapotty. Their theme is \"\u09a8\u09bf\u09b6\u09be\u09a8\". They have depicted Ramnami tribe of Chattisgarh who inscribed the name of Ram in their body. Very good pandal. Highly recommend https://t.co/e0IVUo8IkX", "url": "https://x.com/an1sh123/status/2112432323543339227"}, {"attachments": {"media_keys": ["3_2112398431494995968", "3_2112398439967563776", "3_2112398450767933441", "3_2112398460658077696"]}, "author_id": "1887936048761819136", "created_at": "2026-10-20T04:20:17.000Z", "edit_history_tweet_ids": ["2112398474511876197"], "id": "2112398474511876197", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "\u09aa\u09c1\u099c\u09cb \u09aa\u09b0\u09bf\u0995\u09cd\u09b0\u09ae\u09be 2026 \u09ae\u09be \u09a6\u09c1\u09b0\u09cd\u0997\u09be \u099a\u09cb\u09b0 \u09ac\u09be\u0997\u09be\u09a8 \u0993 \u09a4\u09cd\u09b0\u09bf\u09a7\u09be\u09b0\u09be https://t.co/qORjW7yL21", "url": "https://x.com/Abhijit01629804/status/2112398474511876197"}, {"attachments": {"media_keys": ["3_2112394846552145920", "3_2112394846552178688", "3_2112394846564724736", "3_2112394846560509952"]}, "author_id": "851743937668632576", "created_at": "2026-10-20T04:06:08.000Z", "edit_history_tweet_ids": ["2112394912172024276"], "id": "2112394912172024276", "public_metrics": {"bookmark_count": 0, "impression_count": 47, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "#\u0986\u0995\u09be\u09b6\u09ac\u09be\u09a3\u09c0_\u09b8\u0982\u09ac\