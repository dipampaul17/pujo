{"data": [{"attachments": {"media_keys": ["3_2110225347056902144", "3_2110225347073765377", "3_2110225347111477248", "3_2110225347065360385"]}, "author_id": "130377372", "created_at": "2026-10-14T04:25:07.000Z", "edit_history_tweet_ids": ["2110225362370396587"], "id": "2110225362370396587", "public_metrics": {"bookmark_count": 0, "impression_count": 165, "like_count": 6, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Visited Pratapaditya Road Trikon Park Puja which was inaugurated by Hon'ble Finance Minister Shri @swapan55 da. Later visited Sanghasree Puja. Thanks to @upamanyu95 and Gopal for the warm welcome. https://t.co/SQdmhyG3M0", "url": "https://x.com/keyakahe/status/2110225362370396587"}, {"attachments": {"media_keys": ["3_2110094085742796800"]}, "author_id": "1901956868152717312", "created_at": "2026-10-13T19:43:30.000Z", "edit_history_tweet_ids": ["2110094094798319693"], "id": "2110094094798319693", "public_metrics": {"bookmark_count": 2, "impression_count": 1525, "like_count": 112, "quote_count": 0, "reply_count": 0, "retweet_count": 11}, "text": "Thank you Prime Minister Shri @narendramodi ji on behalf of Sanghashree Durga Puja for the greetings. Wishing you good health and a wonderful Durga Puja. https://t.co/svtgeJYSWI", "url": "https://x.com/upamanyu95/status/2110094094798319693"}, {"attachments": {"media_keys": ["3_2110085775207632896", "3_2110085774863654912", "3_2110085774825963520", "3_2110085774830120960"]}, "author_id": "1901956868152717312", "created_at": "2026-10-13T19:10:29.000Z", "edit_history_tweet_ids": ["2110085785324261736"], "id": "2110085785324261736", "public_metrics": {"bookmark_count": 2, "impression_count": 1555, "like_count": 148, "quote_count": 0, "reply_count": 1, "retweet_count": 7}, "text": "We are happy that our fiery voice of BJP Bengal, @keyakahe di came to visit our Sanghashri Puja Pandal. https://t.co/KAhA4n53Ia", "url": "https://x.com/upamanyu95/status/2110085785324261736"}, {"attachments": {"media_keys